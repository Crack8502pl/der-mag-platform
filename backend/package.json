{
  "name": "der-mag-platform-backend",
  "version": "1.0.0",
  "description": "Backend API dla Cr@ck Platform - system zarządzania zadaniami infrastrukturalnymi",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "NODE_OPTIONS='--max-old-space-size=2048' dotenvx run -- tsx watch src/index.ts",
    "dev:debug": "NODE_OPTIONS='--max-old-space-size=4096' dotenvx run -- tsx watch src/index.ts",
    "build": "tsc && cp -r public dist/ && cp -r scripts dist/ && cp -r src/templates dist/templates && cp -r src/assets dist/assets && npm run test:build-assets",
    "test:build-assets": "node scripts/check-build-assets.js",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest --testPathPattern=unit",
    "test:integration": "jest --testPathPattern=integration",
    "migrate:all": "bash scripts/run-all-migrations.sh",
    "migration:run": "tsx scripts/run-migrations.ts",
    "db:migrate": "node dist/scripts/migrate-and-seed.js",
    "migrate:tokens": "psql ${DB_CONNECTION_STRING:-postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}} -f scripts/migrations/20251116_add_refresh_tokens.sql",
    "migrate:materials": "ts-node scripts/migrate-materials.ts",
    "seed:materials": "ts-node scripts/seed-material-stocks.ts",
    "db:setup": "ts-node scripts/setup-database.ts",
    "db:reset": "bash scripts/db-reset.sh",
    "db:drop": "bash scripts/db-drop.sh",
    "db:create": "bash scripts/db-create.sh",
    "db:verify-setup": "tsx scripts/verify-database-setup.ts",
    "db:backup": "bash scripts/backup-db.sh",
    "db:restore": "bash scripts/restore-db.sh",
    "db:setup-cron": "bash scripts/setup-backup-cron.sh",
    "env:encrypt": "dotenvx encrypt",
    "env:decrypt": "dotenvx decrypt",
    "env:run": "dotenvx run --",
    "env:set": "dotenvx set",
    "env:get": "dotenvx get",
    "audit:production": "npm audit --production",
    "generate-certs": "./scripts/generate-certs.sh",
    "generate-certs:win": "powershell -ExecutionPolicy Bypass -File ./scripts/generate-certs.ps1"
  },
  "overrides": {
    "lodash": "^4.17.21",
    "braces": "^3.0.3",
    "tar": "^7.5.21",
    "diff": "^8.0.3",
    "fast-xml-parser": "^5.3.4",
    "minimatch": "^10.0.3",
    "brace-expansion": "^5.0.9",
    "tough-cookie": "^5.1.0",
    "micromatch": "^4.0.8",
    "glob": "^10.0.0",
    "uuid": "^14.0.0"
  },
  "keywords": [
    "der-mag",
    "task-management",
    "infrastructure",
    "api"
  ],
  "author": "Cr@ck",
  "license": "MIT",
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@types/mssql": "^9.1.9",
    "@types/node-cron": "^3.0.11",
    "@types/uuid": "^10.0.0",
    "bcrypt": "^5.1.1",
    "bull": "^4.16.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "csv-parse": "^7.0.3",
    "csv-stringify": "^6.6.0",
    "docxtemplater": "^3.50.0",
    "dotenv": "^16.3.1",
    "exceljs": "^4.4.0",
    "exifr": "^7.1.3",
    "express": "^4.22.2",
    "express-rate-limit": "^7.5.1",
    "handlebars": "^4.7.8",
    "helmet": "^7.2.0",
    "ioredis": "^5.8.2",
    "jsonwebtoken": "^9.0.3",
    "lodash": "^4.17.21",
    "mathjs": "^15.2.0",
    "morgan": "^1.10.0",
    "mssql": "^12.2.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^4.2.1",
    "nodemailer": "^10.0.13",
    "pdf-lib": "^1.17.1",
    "pg": "^8.21.0",
    "pizzip": "^3.1.7",
    "reflect-metadata": "^0.2.1",
    "sharp": "^0.35.3",
    "typeorm": "^0.3.30",
    "typescript": "^5.9.3",
    "uuid": "^14.0.0",
    "web-push": "^3.6.7",
    "webdav-server": "^2.6.2",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@babel/plugin-transform-modules-commonjs": "^8.0.1",
    "@dotenvx/dotenvx": "^1.34.0",
    "@types/bcrypt": "^5.0.2",
    "@types/bull": "^4.10.4",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/lodash": "^4.17.0",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.10.6",
    "@types/supertest": "^6.0.3",
    "@types/web-push": "^3.6.4",
    "jest": "^29.7.0",
    "pdfjs-dist": "^4.10.38",
    "supertest": "^6.3.4",
    "ts-jest": "^29.4.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.7.0"
  }
}
