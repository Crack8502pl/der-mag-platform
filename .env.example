# Copy to .env and set all required secrets before starting Compose.
DB_NAME=dermag_platform
DB_USER=dermag_user
DB_PASSWORD=

REDIS_PASSWORD=

# Each JWT secret must be at least 32 characters and the two values must differ.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Use a random secret; a 64-character hexadecimal key is recommended.
ENCRYPTION_KEY=

APP_PORT=3000
APP_BIND_ADDRESS=127.0.0.1
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000
ADMIN_EMAIL=admin@example.com

# Optional public HTTPS reverse proxy (docker compose --profile https up -d).
DOMAIN=your-domain.example
CERTBOT_EMAIL=admin@example.com
LETSENCRYPT_DIR=/etc/letsencrypt

# Daily PostgreSQL backups at 02:00 UTC, retained for 30 days.
BACKUP_TIME=02:00
BACKUP_RETENTION_DAYS=30

# Symfonia variables can be added here unchanged. Sync is disabled by default.
SYMFONIA_SYNC_ENABLED=false
